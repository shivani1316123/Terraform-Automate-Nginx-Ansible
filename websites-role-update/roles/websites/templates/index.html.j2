<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ item.title }} — {{ brand_name }}</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <nav class="topnav">
    <div class="brand">{{ brand_name }}</div>
    <div class="nav-links">
      {% for s in sites %}
      <a href="/{{ s.slug }}/" class="{{ 'active' if s.slug == item.slug else '' }}">{{ s.nav_label }}</a>
      {% endfor %}
    </div>
  </nav>

  <section class="hero">
    <div class="hero-left">
      <div class="hero-icon">{{ item.icon }}</div>
      <h1>{{ item.heading }}</h1>
      <p class="subtext">{{ item.subtext }}</p>
      <div class="cta-row">
        <a href="#" class="btn btn-solid">{{ item.primary_cta }}</a>
        <a href="/" class="btn btn-outline">All portals</a>
      </div>
    </div>
    <div class="hero-right">
      {% for stat in item.stats %}
      <div class="stat">
        <div class="stat-value">{{ stat.value }}</div>
        <div class="stat-label">{{ stat.label }}</div>
      </div>
      {% if not loop.last %}<div class="stat-divider"></div>{% endif %}
      {% endfor %}
    </div>
  </section>

  <footer>
    <p>Served by {{ ansible_hostname }} &middot; {{ brand_name }}</p>
  </footer>
</body>
</html>
