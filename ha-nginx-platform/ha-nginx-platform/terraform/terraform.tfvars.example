# Copy to terraform.tfvars and edit
aws_region       = "ap-south-1"
project_name     = "ha-nginx"
instance_type    = "t3.micro"
public_key_path  = "~/.ssh/ha-nginx-key.pub"
private_key_path = "~/.ssh/ha-nginx-key"
ssh_allowed_cidr = "203.0.113.10/32"   # your public IP + /32
alert_email      = ""                  # optional
