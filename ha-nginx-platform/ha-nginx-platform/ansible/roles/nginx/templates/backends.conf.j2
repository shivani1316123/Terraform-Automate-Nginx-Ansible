# {{ ansible_managed }}
# One private server block per website. They listen on 127.0.0.1 only, so the
# only way to reach them from outside is through the reverse proxy.
{% for site in sites %}

# {{ site.title }}
server {
    listen 127.0.0.1:{{ site.port }};
    server_name _;
    root {{ web_root }}/{{ site.slug }};
    index index.html;
    access_log /var/log/nginx/{{ site.slug }}.access.log;

    location / {
        try_files $uri $uri/ =404;
    }
}
{% endfor %}
