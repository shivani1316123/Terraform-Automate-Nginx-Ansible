<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ platform_name }}</title>
  <link rel="stylesheet" href="style.css">
</head>
<body class="hub">
  <main>
    <h1>{{ platform_name }}</h1>
    <p class="lead">Choose a portal. Each one runs as its own site behind a single Nginx reverse proxy.</p>
{% for s in sites %}
    <a class="portal" style="--c: {{ s.bright }}" href="/{{ s.slug }}/">
      <span class="ico" aria-hidden="true">{{ s.icon }}</span>
      <div><h2>{{ s.title }}</h2><p>{{ s.tagline }}</p></div>
      <span class="open">Open</span>
    </a>
{% endfor %}
  </main>
  <footer>
    <div class="in">
      <span>Refresh the page to see the load balancer switch servers.</span>
      <span class="node"><i></i>Served by {{ inventory_hostname }} ({{ ansible_default_ipv4.address }})</span>
    </div>
  </footer>
</body>
</html>
