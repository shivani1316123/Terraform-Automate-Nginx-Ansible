<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ item.title }} | {{ platform_name }}</title>
  <link rel="stylesheet" href="style.css">
  <style>:root { --accent: {{ item.accent }}; --tint: {{ item.tint }}; }</style>
</head>
<body>
  <header class="nav">
    <div class="in">
      <a class="brand" href="/">{{ platform_name }}</a>
      <nav class="links" aria-label="Portals">
{% for s in sites %}
        <a href="/{{ s.slug }}/"{% if s.slug == item.slug %} class="active" aria-current="page"{% endif %}>{{ s.title }}</a>
{% endfor %}
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="in">
        <div>
          <div class="mark" aria-hidden="true">{{ item.icon }}</div>
          <h1>{{ item.headline }}</h1>
          <p>{{ item.tagline }}</p>
          <a class="btn" href="#features">See what you can do</a>
          <a class="btn line" href="/">All portals</a>
        </div>
        <ul class="stats">
{% for st in item.stats %}
          <li><b>{{ st.value }}</b><span>{{ st.label }}</span></li>
{% endfor %}
        </ul>
      </div>
    </section>

    <section class="wrap" id="features">
      <h2>What you can do in the {{ item.title }}</h2>
      <div class="features">
{% for f in item.features %}
        <article class="feature">
          <div class="ico" aria-hidden="true">{{ f.icon }}</div>
          <h3>{{ f.title }}</h3>
          <p>{{ f.text }}</p>
        </article>
{% endfor %}
      </div>
    </section>
  </main>

  <footer>
    <div class="in">
      <span>{{ platform_name }}, routed by Nginx from /{{ item.slug }}/ to 127.0.0.1:{{ item.port }}</span>
      <span class="node"><i></i>Served by {{ inventory_hostname }} ({{ ansible_default_ipv4.address }})</span>
    </div>
  </footer>
</body>
</html>
