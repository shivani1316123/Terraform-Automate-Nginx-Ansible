[Unit]
Description=Nginx Prometheus Exporter
After=network.target nginx.service

[Service]
User=nginx_exporter
Group=nginx_exporter
Type=simple
ExecStart=/usr/local/bin/nginx-prometheus-exporter --nginx.scrape-uri=http://127.0.0.1/nginx_status --web.listen-address=:9113

[Install]
WantedBy=multi-user.target
